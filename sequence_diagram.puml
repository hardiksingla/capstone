@startuml Use Case Diagram

title BBIA-OCA Use Case Diagram

left to right direction

actor Student
actor Instructor
actor "Chrome Extension" as ext
actor "ML Model" as ml

rectangle "BBIA-OCA System" {

    rectangle "Data Collection" {
        usecase "Solve coding problem\non LeetCode" as UC1
        usecase "Capture behavioral\nevents" as UC2
        usecase "Export session\nas JSON" as UC3
    }

    rectangle "Model Training" {
        usecase "Extract 58 behavioral\nfeatures" as UC4
        usecase "Train Logistic\nRegression" as UC5
        usecase "Train Linear SVM" as UC6
        usecase "Evaluate with 5-fold\nCross-Validation" as UC7
        usecase "Save trained\nmodel artifacts" as UC8
    }

    rectangle "Session Analysis" {
        usecase "Upload session\nJSON file" as UC9
        usecase "Analyze behavioral\npatterns" as UC10
        usecase "Generate suspicion\nscore" as UC11
        usecase "Classify risk level\n(LOW/MEDIUM/HIGH/CRITICAL)" as UC12
        usecase "View behavioral\nindicators" as UC13
        usecase "Flag session for\nmanual review" as UC14
    }
}

Student --> UC1
